# Install as /etc/kma/dashboard.env, owner root, group tom, mode 0640.
# An R2 API token with "Object Read & Write", scoped to the single bucket
# kenya-monitor-dashboard. It must not cover kenya-monitor-2027.
R2_DASHBOARD_ACCESS_KEY_ID=
R2_DASHBOARD_SECRET_ACCESS_KEY=
R2_DASHBOARD_BUCKET=kenya-monitor-dashboard
