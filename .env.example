R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-s3-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-s3-secret-access-key
R2_BUCKET=kenya-monitor-2027

# X (Twitter) Scraper Backend Selection: "twscrape" or "apify"
X_BACKEND=twscrape
# Required only if X_BACKEND=apify
APIFY_TOKEN=your-apify-token
# Optional: "xquik/x-tweet-scraper" (default) or "apidojo/tweet-scraper"
APIFY_ACTOR_ID=xquik/x-tweet-scraper

# Account pool throughput (collector on pi0). Defaults suit ~50+ twscrape accounts.
# REQUEST_DELAY_MIN/MAX apply per scraping account between its own requests.
# Per-account cooldown between that account's own requests. Mean 10s = the
# 2026-09-05 rate cut; was 3/12. Raise both to slow down further.
REQUEST_DELAY_MIN=4
REQUEST_DELAY_MAX=16
COLLECT_CONCURRENCY=3
METRICS_MAX_POSTS_PER_ACCOUNT=8
METRICS_MAX_POSTS_FLOOR=200
ACCOUNT_SYNC_HOURS=6

# Search / snowball / adaptive (see docs/collection/README.md)
SEARCH_INCLUDE_RETWEETS=1
SEARCH_PRODUCT=Latest
SNOWBALL_TOP_RETWEETED=250
SNOWBALL_TOP_CONVERSATIONS=250
SNOWBALL_HYDRATE_LIMIT=150
SNOWBALL_REFRESH_HOURS=12
DYNAMIC_MAX_KEYWORDS=10
DYNAMIC_MAX_ACCOUNTS=60
BURST_ZSCORE=3.0

# Follow graph collection
FOLLOW_FETCH_LIMIT=500
FOLLOW_MAX_ACCOUNTS=30
FOLLOW_CRAWL_MAX_PER_RUN=50
FOLLOW_CRAWL_REFRESH_DAYS=30

# Hate-seeking collection (docs/collection/hate-seeking.md).
# Own cycle step + own semaphore; never merged into the baseline keyword pool.
HATE_SEEK_ENABLED=1
HATE_SEEK_EVERY_N_CYCLES=3   # run on every Nth cycle (higher = less often)
HATE_SEEK_MAX_TERMS=8        # terms per pass, rotated least-recently-searched
HATE_TARGET_MAX_TERMS=3      # reserved ethnonym x menace slots
HATE_SEEK_WINDOW_LIMIT=15    # max posts per term per day-window
HATE_SEED_MAX_ACCOUNTS=20    # seed accounts expanded per pass
CLUSTER_PROMOTION_ENABLED=1  # 0 disables promoting coordination-cluster members
CLUSTER_MIN_CHANNELS=2       # corroboration floor for cluster promotion
CLUSTER_MIN_KENYA_SHARE=0.15 # min Kenya-domain share before a cluster promotes
KEYWORD_MIN_KENYA_SHARE=0.10 # same gate for bursting hashtags
HATE_MINE_AUTOPROMOTE=0      # mined terms are human-gated by default
COORD_REFRESH_HOURS=6        # analysis worker rebuilds+persists clusters this often
